[Unit]
Description=AntiClone Dev public gateway (private NPM mTLS upstream)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/apps/apps/personal/anticlone-dev/dev-gateway-release
ExecStart=/usr/bin/env -i /opt/apps/apps/personal/anticlone-dev/bin/node --env-file=/opt/apps/apps/personal/anticlone-dev/private/dev-public-gateway/gateway.env dist/apps/server.js
UMask=0077
NoNewPrivileges=yes
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target

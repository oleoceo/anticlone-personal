# MODELO SOMENTE. Copiar fora do Git e proteger; não usar source.
DATABASE_URL=postgres://anticlone:SUBSTITUIR_SENHA_PERCENT_ENCODED@127.0.0.1:54332/anticlone
PUBLIC_GATEWAY_HOST=runtime.owner.example
RUNTIME_PUBLIC_ORIGIN=https://runtime.owner.example
# Sem SMTP externo na primeira inicialização observacional.
SMTP_PORT=1
# Após autorização: adicionar conjunto CLONE-SMTP.md e recriar containers (ver roteiro).
# Não definir PROJECT_ID, PILOT_ORIGINS, ALLOWED_ORIGIN ou fixtures LAB.
# Integração comercial autorizada: COMMERCE_ENCRYPTION_KEY privada (32 bytes em hex).
# Mesma chave no gateway receptor, admin e ambiente do commerce-provision.js.
# Conexão criada no admin exige essa mesma chave no receptor; não gerar por processo.
# Recriar gateway/admin após inclusão nos env-files; restart não recarrega ambiente.
# Backup privado obrigatório; nunca expor em logs/Git/browser ou argumentos.
# Não rotacionar chave mestra sem mecanismo de recriptografia (não implementado).
